# =============================================================================
# cmoAI - Environment Configuration Template
# =============================================================================
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
#
# Never commit the real ".env" file — it is already excluded in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Main Reasoning Model (Orchestrator: diagnosis, strategy, report generation)
# Choose ONE provider and fill in its key. Set MAIN_LLM_PROVIDER accordingly.
# -----------------------------------------------------------------------------
MAIN_LLM_PROVIDER=gemini
# Options: gemini | nemotron

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct

# -----------------------------------------------------------------------------
# Small Model (Market Research + Information Extraction services)
# Can be the same provider as above with a lighter/faster model, or a
# different free provider entirely.
# -----------------------------------------------------------------------------
SMALL_LLM_PROVIDER=gemini
# Options: gemini | nemotron

SMALL_LLM_MODEL=gemini-2.0-flash-lite

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
SQLITE_DB_PATH=./data/cmoai.db

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
# Options: development | production

LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

LOG_DIR=./logs

# -----------------------------------------------------------------------------
# Web / API layer (used starting from a later brick, defined now for consistency)
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# -----------------------------------------------------------------------------
# Website Collector Service
# -----------------------------------------------------------------------------
WEBSITE_COLLECTOR_TIMEOUT_SECONDS=15
WEBSITE_COLLECTOR_MAX_PAGES=8
WEBSITE_COLLECTOR_USER_AGENT=Mozilla/5.0 (compatible; cmoAI-WebsiteCollector/1.0)
WEBSITE_COLLECTOR_POLITE_DELAY_SECONDS=0.5

